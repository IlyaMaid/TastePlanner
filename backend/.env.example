DEBUG=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tasteplanner
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Used to build the password reset link sent to users.
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Optional SMTP settings. If SMTP_HOST is left empty, password reset links
# are written to the backend log instead of being emailed (dev fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TastePlanner <no-reply@tasteplanner.local>
SMTP_USE_TLS=true
